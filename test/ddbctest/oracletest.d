    pragma(msg, "DDBC test will run Oracle tests (native driver)");

    /// URL of the test server: ORACLE_PORT (default 1521), ORACLE_SERVICE (default FREEPDB1),
    /// ORACLE_USER (default testuser), ORACLE_PASSWORD.
    string oracleUrl() {
        return "ddbc:oracle://localhost:%s/%s?user=%s,password=%s".format(environment.get("ORACLE_PORT", "1521"),
                environment.get("ORACLE_SERVICE", "FREEPDB1"), environment.get("ORACLE_USER", "testuser"),
                environment.get("ORACLE_PASSWORD", "Test_password123"));
    }

    /// A PL/SQL block that drops `table` if it exists (Oracle before 23ai has no DROP TABLE IF EXISTS).
    string dropTable(string table) {
        return "BEGIN EXECUTE IMMEDIATE 'DROP TABLE " ~ table ~ " PURGE'; "
            ~ "EXCEPTION WHEN OTHERS THEN IF SQLCODE != -942 THEN RAISE; END IF; END;";
    }

    /// A PL/SQL block that creates `table` with `columns`, dropping an old one first.
    string recreateTable(string table, string columns) {
        return "BEGIN BEGIN EXECUTE IMMEDIATE 'DROP TABLE " ~ table ~ " PURGE'; "
            ~ "EXCEPTION WHEN OTHERS THEN IF SQLCODE != -942 THEN RAISE; END IF; END; "
            ~ "EXECUTE IMMEDIATE 'CREATE TABLE " ~ table ~ " (" ~ columns ~ ")'; END;";
    }

    class OracleTest : DdbcTestFixture {
        mixin UnitTest;

        this() {
            super(
                oracleUrl(),
                recreateTable("my_first_test", "id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, name NVARCHAR2(255) NOT NULL"),
                dropTable("my_first_test")
            );
        }

        @Test
        public void testVerifyTableExists() {
            Statement stmt = conn.createStatement();
            scope(exit) stmt.close();

            ResultSet rs = stmt.executeQuery(`SELECT table_name FROM user_tables WHERE table_name = 'MY_FIRST_TEST'`);
            assertTrue(rs.next());
            assertEquals("MY_FIRST_TEST", rs.getString(rs.findColumn("table_name")));
            assertFalse(rs.next());
        }

        /// Insert ids come from `RETURNING ... INTO ?`.
        @Test
        public void testInsertAndReturning() {
            Statement stmt = conn.createStatement();
            scope(exit) stmt.close();

            Variant id;
            assertEquals(1, stmt.executeUpdate(`INSERT INTO my_first_test (name) VALUES ('first')`, id));
            assertFalse(id.hasValue); // no RETURNING clause
            assertEquals(1, stmt.executeUpdate(`INSERT INTO my_first_test (name) VALUES (N'Grüße, мир') RETURNING id INTO ?`, id));
            assertEquals(2L, id.get!long);

            PreparedStatement ps = conn.prepareStatement("INSERT INTO my_first_test (name) VALUES (?) RETURNING id INTO ?");
            scope(exit) ps.close();
            assertEquals(2, ps.getParameterMetaData().getParameterCount());
            ps.setString(1, "third");
            assertEquals(1, ps.executeUpdate(id));
            assertEquals(3L, id.get!long);
            ps.setString(1, "fourth");
            assertEquals(1, ps.executeUpdate()); // the RETURNING target needs no value

            PreparedStatement rowid = conn.prepareStatement("UPDATE my_first_test SET name = :name WHERE id = :id RETURNING ROWID INTO :r");
            scope(exit) rowid.close();
            rowid.setString(1, "second");
            rowid.setLong(2, 2);
            assertEquals(1, rowid.executeUpdate(id));
            assertEquals(typeid(string), id.type);

            assertEquals(4, stmt.executeUpdate(`UPDATE my_first_test SET name = name`, id));
            assertFalse(id.hasValue);
            assertThrown!SQLException(stmt.executeUpdate(`DELETE FROM my_first_test WHERE id = ?`)); // no value

            ResultSet rs = stmt.executeQuery(`SELECT name FROM my_first_test WHERE id = 2`);
            assertTrue(rs.next());
            assertEquals("second", rs.getString(1));
            rs = stmt.executeQuery(`SELECT name FROM my_first_test WHERE id = 3`);
            assertTrue(rs.next());
            assertEquals("third", rs.getString(1));
        }

        @Test
        public void testPods() {
            static struct my_first_test { // the table's name
                long id;
                string name;
            }
            Statement stmt = conn.createStatement();
            scope(exit) stmt.close();
            my_first_test row;
            row.name = "pods";
            assertTrue(stmt.insert!my_first_test(row));
            assertEquals(1L, row.id);
            auto found = stmt.get!my_first_test(1);
            assertEquals("pods", found.name);
            int count;
            foreach (r; stmt.select!my_first_test)
                count++;
            assertEquals(1, count);
        }
    }

    // Exact decimals: https://github.com/buggins/ddbc/issues/158
    class OracleDecimalTest : DdbcTestFixture {
        mixin UnitTest;

        this() {
            super(
                oracleUrl(),
                recreateTable("ddbc_decimal", "id NUMBER(10) PRIMARY KEY, amount NUMBER(30,4), missing NUMBER(30,4)"),
                dropTable("ddbc_decimal")
            );
        }

        @Test
        public void testDecimalRoundTrip() {
            checkDecimalRoundTrip(conn, "ddbc_decimal", true, ["12.3400", "-0.0005", "12345678901234567890123456.5678", "0.0000"]);
        }

        @Test
        public void testDecimalFromOtherColumns() {
            Statement stmt = conn.createStatement();
            scope(exit) stmt.close();
            auto rs = stmt.executeQuery("SELECT CAST(1.5 AS NUMBER(5,2)), 42, '7.25', CAST(0.5 AS BINARY_DOUBLE), 1e-130 FROM dual");
            assertTrue(rs.next());
            assertEquals("1.50", rs.getDecimal(1).toFixedString()); // the column's scale
            assertEquals("42", rs.getDecimal(2).toString());
            assertEquals("7.25", rs.getDecimal(3).toString());
            assertEquals("0.5", rs.getDecimal(4).toString());
            assertEquals(1e-130, rs.getDouble(5));
        }
    }

    class OracleTypesTest : DdbcTestFixture {
        mixin UnitTest;

        this() {
            super(
                oracleUrl(),
                recreateTable("typed_values", "id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, flag NUMBER(1), "
                    ~ "tiny NUMBER(3), small NUMBER(5), big NUMBER(19), amount NUMBER(12,2), "
                    ~ "real_value BINARY_FLOAT, float_value BINARY_DOUBLE, title NVARCHAR2(100), "
                    ~ "label VARCHAR2(50), code CHAR(4), data RAW(10), day DATE, at_time DATE, moment TIMESTAMP(3), "
                    ~ "instant TIMESTAMP(3) WITH TIME ZONE, notes CLOB, image BLOB"),
                dropTable("typed_values")
            );
        }

        /// Every setter and getter through a prepared statement, and NULLs of each type.
        @Test
        public void testSettersAndGetters() {
            import std.array : replicate;

            PreparedStatement ps = conn.prepareStatement("INSERT INTO typed_values (flag, tiny, small, big, amount, "
                ~ "real_value, float_value, title, label, code, data, day, at_time, moment, instant, notes, image) "
                ~ "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)");
            scope(exit) ps.close();
            const tz = new immutable SimpleTimeZone(minutes(-330));
            const notes = "Grüße, мир ".replicate(5000); // longer than 32767 bytes: sent as a LONG
            auto image = new ubyte[40_000];
            foreach (i, ref b; image)
                b = cast(ubyte) i;
            ps.setBoolean(1, true);
            ps.setUbyte(2, 255);
            ps.setShort(3, -32_768);
            ps.setLong(4, long.max);
            ps.setDecimal(5, Decimal.fromString("-1234567890.25"));
            ps.setFloat(6, 1.5f);
            ps.setDouble(7, -0.1);
            ps.setString(8, "Grüße, мир 😀");
            ps.setString(9, "мир");
            ps.setString(10, "ab");
            ps.setUbytes(11, [1, 2, 3]);
            ps.setDate(12, Date(2024, 2, 29));
            ps.setTime(13, TimeOfDay(23, 59, 59));
            ps.setDateTime(14, DateTime(2024, 1, 31, 12, 34, 56));
            ps.setSysTime(15, SysTime(DateTime(2024, 1, 31, 12, 0, 0), tz));
            ps.setString(16, notes);
            ps.setUbytes(17, image);
            assertEquals(1, ps.executeUpdate());
            foreach (i; 1 .. 18)
                ps.setNull(i, [SqlType.BIT, SqlType.TINYINT, SqlType.SMALLINT, SqlType.BIGINT, SqlType.DECIMAL,
                    SqlType.FLOAT, SqlType.DOUBLE, SqlType.NVARCHAR, SqlType.VARCHAR, SqlType.NCHAR,
                    SqlType.VARBINARY, SqlType.DATE, SqlType.TIME, SqlType.DATETIME, SqlType.DATETIME,
                    SqlType.CLOB, SqlType.BLOB][i - 1]);
            assertEquals(1, ps.executeUpdate());

            Statement stmt = conn.createStatement();
            scope(exit) stmt.close();
            ResultSet rs = stmt.executeQuery("SELECT * FROM typed_values ORDER BY id");
            assertTrue(rs.next());
            assertTrue(rs.getBoolean(2));
            assertEquals(255, rs.getUbyte(3));
            assertEquals(-32_768, rs.getShort(4));
            assertEquals(long.max, rs.getLong(5));
            assertEquals(cast(ulong) long.max, rs.getUlong(5));
            assertEquals("-1234567890.25", rs.getDecimal(6).toFixedString());
            assertEquals(1.5f, rs.getFloat(7));
            assertEquals(-0.1, rs.getDouble(8));
            assertEquals("Grüße, мир 😀", rs.getString(9));
            assertEquals("мир", rs.getString(10));
            assertEquals("ab  ", rs.getString(11)); // CHAR is padded
            assertEquals(cast(ubyte[]) [1, 2, 3], rs.getUbytes(12));
            assertEquals(Date(2024, 2, 29), rs.getDate(13));
            assertEquals(TimeOfDay(23, 59, 59), rs.getTime(14));
            assertEquals(DateTime(2024, 1, 31, 12, 34, 56), rs.getDateTime(15));
            // TIMESTAMP WITH TIME ZONE keeps the point in time and the offset
            assertEquals(SysTime(DateTime(2024, 1, 31, 17, 30, 0), UTC()), rs.getSysTime(16));
            assertEquals(notes, rs.getString(17));
            assertEquals(image, rs.getUbytes(18));
            assertEquals(Variant(1L), rs.getVariant(2));
            assertEquals(typeid(Decimal), rs.getVariant(6).type);
            assertFalse(rs.isLast());

            assertTrue(rs.next());
            foreach (c; 2 .. 19) {
                assertTrue(rs.isNull(c));
                assertFalse(rs.getVariant(c).hasValue);
            }
            assertEquals(0, rs.getInt(3));
            assertTrue(rs.wasNull());
            assertNull(rs.getString(9));
            assertNull(rs.getUbytes(18));
            assertTrue(rs.isLast());
            assertFalse(rs.next());

            ps.clearParameters();
            assertThrown!SQLException(ps.executeUpdate()); // parameters not set
        }

        /// Result set metadata from the column types.
        @Test
        public void testMetadata() {
            Statement stmt = conn.createStatement();
            scope(exit) stmt.close();
            ResultSet rs = stmt.executeQuery("SELECT id, flag, big, amount, real_value, float_value, title, code, data, day, "
                ~ "moment, instant, notes, image, ROWID FROM typed_values");
            ResultSetMetaData meta = rs.getMetaData();
            assertEquals(15, meta.getColumnCount());
            assertEquals("ID", meta.getColumnName(1));
            assertEquals(SqlType.NUMERIC, meta.getColumnType(1));
            assertEquals(0, meta.isNullable(1));
            assertEquals(SqlType.INTEGER, meta.getColumnType(2));
            assertEquals(1, meta.isNullable(2));
            assertEquals(SqlType.NUMERIC, meta.getColumnType(3)); // NUMBER(19) exceeds a long
            assertEquals(SqlType.NUMERIC, meta.getColumnType(4));
            assertEquals(12, meta.getPrecision(4));
            assertEquals(2, meta.getScale(4));
            assertEquals("NUMBER(12,2)", meta.getColumnTypeName(4));
            assertEquals(SqlType.FLOAT, meta.getColumnType(5));
            assertEquals(SqlType.DOUBLE, meta.getColumnType(6));
            assertEquals(SqlType.NVARCHAR, meta.getColumnType(7));
            assertEquals(100, meta.getColumnDisplaySize(7));
            assertEquals(SqlType.CHAR, meta.getColumnType(8));
            assertEquals(SqlType.VARBINARY, meta.getColumnType(9));
            assertEquals(SqlType.DATETIME, meta.getColumnType(10));
            assertEquals(SqlType.DATETIME, meta.getColumnType(11));
            assertEquals(3, meta.getScale(11));
            assertEquals(SqlType.DATETIME, meta.getColumnType(12));
            assertEquals(SqlType.CLOB, meta.getColumnType(13));
            assertEquals(SqlType.BLOB, meta.getColumnType(14));
            assertEquals(SqlType.OTHER, meta.getColumnType(15));
            assertEquals("ROWID", meta.getColumnTypeName(15));
            assertFalse(rs.next());
        }

        @Test
        public void testConversions() {
            Statement stmt = conn.createStatement();
            scope(exit) stmt.close();

            ResultSet rs = stmt.executeQuery("SELECT CAST(1234.5 AS NUMBER(12, 3)), '17', 'true', CAST(NULL AS NUMBER(5, 1)), "
                ~ "42, 18446744073709551615, -1, '' FROM dual");
            assertTrue(rs.next());
            assertEquals(1234.5, rs.getDouble(1));
            assertEquals("1234.5", rs.getString(1));
            assertEquals("1234.500", rs.getDecimal(1).toFixedString());
            assertThrown!SQLException(rs.getLong(1)); // a fraction
            assertEquals(17, rs.getInt(2)); // text converted
            assertTrue(rs.getBoolean(3));
            assertEquals(0.0, rs.getDouble(4));
            assertTrue(rs.wasNull());
            assertEquals(42, rs.getInt(5));
            assertEquals("42", rs.getString(5));
            assertEquals(ulong.max, rs.getUlong(6));
            assertThrown!SQLException(rs.getLong(6)); // too big
            assertThrown!SQLException(rs.getUlong(7)); // negative
            assertThrown!SQLException(rs.getUbyte(7)); // negative
            assertTrue(rs.isNull(8)); // an empty string is NULL
            assertThrown!SQLException(rs.getDate(5)); // not a date
            assertFalse(rs.next());
        }

        @Test
        public void testReadingLongValues() {
            Statement stmt = conn.createStatement();
            scope(exit) stmt.close();

            ResultSet rs = stmt.executeQuery("SELECT "
                ~ "TO_CLOB(RPAD('a', 4000, 'a')) || RPAD('b', 4000, 'b') || RPAD('c', 4000, 'c'), "
                ~ "TO_NCLOB(RPAD(N'xм', 3000, N'xм')), "
                ~ "TO_BLOB(HEXTORAW(RPAD('7A', 4000, '7A'))), "
                ~ "RPAD('z', 4000, 'z'), "
                ~ "TO_CLOB(NULL) FROM dual");
            assertTrue(rs.next());
            string text = rs.getString(1);
            assertEquals(12_000, text.length);
            assertEquals("aaab", text[3997 .. 4001]);
            dstring chars = to!dstring(rs.getString(2));
            assertEquals(2000, chars.length); // NVARCHAR2 holds 4000 bytes of UTF-16
            assertEquals("xмxм"d, chars[0 .. 4]);
            byte[] bytes = rs.getBytes(3);
            assertEquals(2000, bytes.length);
            assertEquals(cast(byte) 'z', bytes[$ - 1]);
            assertEquals(4000, rs.getString(4).length);
            assertTrue(rs.isNull(5));
            assertFalse(rs.next());
        }

        /// A result set stays readable while other statements run on the connection.
        @Test
        public void testInterleavedStatements() {
            Statement insert = conn.createStatement();
            scope(exit) insert.close();
            foreach (i; 0 .. 250)
                insert.executeUpdate("INSERT INTO typed_values (small) VALUES (" ~ to!string(i) ~ ")");
            Statement reader = conn.createStatement();
            scope(exit) reader.close();
            ResultSet rs = reader.executeQuery("SELECT small FROM typed_values ORDER BY small");
            assertTrue(rs.first());
            assertEquals(0, rs.getInt(1));
            assertTrue(rs.first()); // still on the first row
            assertTrue(rs.next());
            // another statement on the same connection: the rest of rs is read into memory
            Statement other = conn.createStatement();
            scope(exit) other.close();
            ResultSet count = other.executeQuery("SELECT COUNT(*) FROM typed_values");
            assertTrue(count.next());
            assertEquals(250, count.getInt(1));
            int n = 2;
            while (rs.next()) {
                assertEquals(n, rs.getInt(1));
                n++;
            }
            assertEquals(250, n);
            assertEquals(251, rs.getRow()); // after the last row
            assertThrown!SQLException(rs.first()); // forward-only

            // a result set closed before its end
            rs = reader.executeQuery("SELECT small FROM typed_values ORDER BY small");
            assertTrue(rs.next());
            rs.close();
            rs = reader.executeQuery("SELECT COUNT(*) FROM typed_values WHERE small >= 100");
            assertTrue(rs.next());
            assertEquals(150, rs.getInt(1));
        }
    }

    class OracleConnectionTest : DdbcTestFixture {
        mixin UnitTest;

        this() {
            super(oracleUrl());
        }

        /// ODBC-style parameter names work too.
        @Test
        public void testUrlForms() {
            auto other = createConnection("ddbc:oracle://localhost:%s?service_name=%s,username=%s,pwd=%s,driver=Oracle,fetch_size=2".format(
                    environment.get("ORACLE_PORT", "1521"), environment.get("ORACLE_SERVICE", "FREEPDB1"),
                    environment.get("ORACLE_USER", "testuser"), environment.get("ORACLE_PASSWORD", "Test_password123")));
            scope(exit) other.close();
            assertEquals("PL/SQL", cast(string) other.getDialectType());
            Statement stmt = other.createStatement();
            scope(exit) stmt.close();
            ResultSet rs = stmt.executeQuery("SELECT LEVEL FROM dual CONNECT BY LEVEL <= 5");
            int n;
            while (rs.next())
                assertEquals(++n, rs.getInt(1));
            assertEquals(5, n);
        }

        @Test
        public void testCatalog() {
            const user = environment.get("ORACLE_USER", "testuser").to!string;
            import std.uni : toUpper;

            assertEquals(user.toUpper, conn.getCatalog());
            conn.setCatalog("sys");
            assertEquals("SYS", conn.getCatalog());
            conn.setCatalog(user);
            assertEquals(user.toUpper, conn.getCatalog());
        }

        @Test
        public void testServerErrors() {
            Statement stmt = conn.createStatement();
            scope(exit) stmt.close();
            assertThrown!SQLException(stmt.executeQuery("SELECT * FROM no_such_table"));
            assertThrown!SQLException(stmt.executeUpdate("SELEC 1 FROM dual"));
            ResultSet rs = stmt.executeQuery("SELECT 2 FROM dual");
            assertTrue(rs.next());
            assertEquals(2, rs.getInt(1));
            PreparedStatement ps = conn.prepareStatement("SELECT ?, ? FROM dual");
            scope(exit) ps.close();
            ps.setInt(1, 1);
            assertThrown!SQLException(ps.executeQuery()); // parameter 2 not set
            ps.setInt(2, 2);
            rs = ps.executeQuery();
            assertTrue(rs.next());
            assertEquals(2, rs.getInt(2));
            assertEquals(2, ps.getParameterMetaData().getParameterCount());
            assertEquals(SqlType.NUMERIC, ps.getParameterMetaData().getParameterType(1));
        }
    }

    class OracleTransactionTest : DdbcTestFixture {
        mixin UnitTest;

        this() {
            super(
                oracleUrl(),
                recreateTable("records", "id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, name VARCHAR2(255) NOT NULL"),
                dropTable("records")
                );
        }

        /// Whether a row is visible from another session: only committed rows are.
        private bool committed(string name) {
            auto other = createConnection(oracleUrl());
            scope(exit) other.close();
            Statement stmt = other.createStatement();
            scope(exit) stmt.close();
            ResultSet rs = stmt.executeQuery("SELECT * FROM records WHERE name = '" ~ name ~ "'");
            return rs.next();
        }

        private void insert(string name) {
            Statement stmt = conn.createStatement();
            scope(exit) stmt.close();
            stmt.executeUpdate("INSERT INTO records (name) VALUES ('" ~ name ~ "')");
        }

        @Test
        public void testAutocommitOn() {
            conn.setAutoCommit(true);
            insert("Bob");
            conn.rollback(); // nothing to roll back
            assertTrue(committed("Bob"));
            PreparedStatement ps = conn.prepareStatement("INSERT INTO records (name) VALUES (?)");
            scope(exit) ps.close();
            ps.setString(1, "Jim");
            ps.executeUpdate();
            assertTrue(committed("Jim"));
        }

        @Test
        public void testAutocommitOff() {
            conn.setAutoCommit(false);
            conn.setAutoCommit(false); // duplicate calls are fine
            assertFalse(conn.getAutoCommit());
            insert("Greg");
            assertFalse(committed("Greg"));
            conn.rollback();
            insert("Tom");
            conn.commit();
            assertTrue(committed("Tom"));
            Statement stmt = conn.createStatement();
            scope(exit) stmt.close();
            ResultSet rs = stmt.executeQuery("SELECT COUNT(*) FROM records");
            assertTrue(rs.next());
            assertEquals(1, rs.getInt(1));
        }

        @Test
        public void testAutocommitOffOn() {
            conn.setAutoCommit(false);
            insert("Abe");
            assertFalse(committed("Abe"));
            conn.setAutoCommit(true); // commits
            assertTrue(committed("Abe"));
            insert("Bart");
            assertTrue(committed("Bart"));
        }

        @Test
        public void testAutocommitFromUrl() {
            auto manual = createConnection(oracleUrl() ~ ",auto_commit=false");
            scope(exit) manual.close();
            assertFalse(manual.getAutoCommit());
            Statement stmt = manual.createStatement();
            scope(exit) stmt.close();
            stmt.executeUpdate("INSERT INTO records (name) VALUES ('Carl')");
            assertFalse(committed("Carl"));
            manual.rollback();
        }

        @Test
        public void testTransactionIsolation() {
            conn.setAutoCommit(false);
            conn.setTransactionIsolation(TransactionIsolation.SERIALIZABLE);
            assertEquals(TransactionIsolation.SERIALIZABLE, conn.getTransactionIsolation());
            insert("Sam");
            conn.rollback();
            conn.setTransactionIsolation(TransactionIsolation.READ_COMMITTED);
            assertEquals(TransactionIsolation.READ_COMMITTED, conn.getTransactionIsolation());
            assertThrown!SQLException(conn.setTransactionIsolation(TransactionIsolation.REPEATABLE_READ));
            assertThrown!SQLException(conn.setTransactionIsolation(TransactionIsolation.READ_UNCOMMITTED));
            assertThrown!SQLException(conn.setTransactionIsolation(TransactionIsolation.NONE));
        }
    }
